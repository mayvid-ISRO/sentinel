# IRIS Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── LLM (Phase 0/6) ──────────────────────────────────────
IRIS_LLM_URL=https://router.bynara.id/v1/chat/completions
IRIS_LLM_MODEL=agnes-2.5-flash
IRIS_LLM_API_KEY=your_api_key_here
IRIS_LLM_TIMEOUT_SECONDS=180
IRIS_LLM_MAX_RETRIES=2

# ── Backend (Phase 0) ────────────────────────────────────
IRIS_BACKEND_PORT=8000
IRIS_BACKEND_HOST=0.0.0.0

# ── Auth (Phase 3) ───────────────────────────────────────
IRIS_AUTH_SECRET=change-this-to-a-random-string
IRIS_AUTH_TOKEN_EXPIRE_MINUTES=480

# ── Fleet Nodes (Phase 5) ────────────────────────────────
# Node tokens are read from env at runtime:
# IRIS_NODE_TOKEN_<NODE_NAME> e.g. IRIS_NODE_TOKEN_WORKSTATION_01
